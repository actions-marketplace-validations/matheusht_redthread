{
  "name": "PyRIT adapter capability gates",
  "components": [
    {"id": "redthread_algorithms", "name": "RedThread algorithms and supervisor", "type": "orchestration", "trust_boundary": "redthread_core"},
    {"id": "safe_send", "name": "send_with_execution_metadata", "type": "send_boundary", "trust_boundary": "redthread_adapter"},
    {"id": "containment", "name": "Canary containment and live authorization", "type": "security_control", "trust_boundary": "redthread_adapter"},
    {"id": "capability_gate", "name": "Capability preflight gate", "type": "security_control", "trust_boundary": "redthread_adapter"},
    {"id": "redthread_target", "name": "RedThreadTarget", "type": "adapter", "trust_boundary": "redthread_adapter"},
    {"id": "pyrit_target", "name": "PyRIT PromptChatTarget", "type": "external_library", "trust_boundary": "pyrit"},
    {"id": "provider", "name": "Provider endpoint", "type": "external_service", "trust_boundary": "provider"},
    {"id": "execution_logs", "name": "Execution logs", "type": "evidence", "trust_boundary": "redthread_evidence"}
  ],
  "flows": [
    {"from": "redthread_algorithms", "to": "safe_send", "data": "prompt and execution metadata"},
    {"from": "safe_send", "to": "containment", "data": "prompt and canary metadata"},
    {"from": "containment", "to": "capability_gate", "data": "allowed send request"},
    {"from": "capability_gate", "to": "redthread_target", "data": "supported request"},
    {"from": "redthread_target", "to": "pyrit_target", "data": "PyRIT message"},
    {"from": "pyrit_target", "to": "provider", "data": "provider API request"},
    {"from": "capability_gate", "to": "execution_logs", "data": "unsupported capability failure"}
  ],
  "threats": [
    {"id": "bypass_shared_send", "severity": "high", "risk": "New paths call PyRIT directly and bypass containment", "mitigation": "Keep all production sends behind send_with_execution_metadata and RedThreadTarget"},
    {"id": "capability_overtrust", "severity": "medium", "risk": "Capability claims are treated as evidence of safety", "mitigation": "Use capabilities only for preflight, not judge or promotion proof"},
    {"id": "memory_confusion", "severity": "medium", "risk": "PyRIT memory becomes canonical evidence", "mitigation": "Keep RedThread memory and execution records authoritative"},
    {"id": "scope_creep", "severity": "medium", "risk": "Converters or scorers expand the product surface", "mitigation": "Defer converters; reject PyRIT scorer authority"}
  ]
}
